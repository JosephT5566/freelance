    "@mui/material": "^5.18.0",
    "@react-spring/web": "^10.1.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-use-gesture": "^9.1.3",
    "swr": "^2.4.1",
    "tss-react": "^4.9.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.25",
