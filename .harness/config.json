{
  "schema_version": 1,
  "base": "main",
  "max_fix_rounds": 2,
  "command_timeout": 900,
  "review_timeout": 1200,
  "checks": [
    { "name": "site-check", "argv": ["npm", "run", "check"] },
    {
      "name": "dependency-audit",
      "argv": ["npm", "audit", "--audit-level=high", "--json"]
    },
    {
      "name": "secrets",
      "argv": ["gitleaks", "git", ".", "--no-banner", "--redact"]
    }
  ],
  "sensitive_paths": [
    "worker/**",
    ".github/**",
    "wrangler.toml",
    ".harness/**",
    "tools/harness/**",
    "AGENTS.md",
    ".agents/**"
  ],
  "visual_paths": [
    "app/**",
    "src/**",
    "styles/**",
    "public/**",
    "next.config.*"
  ],
  "context": [
    "AGENTS.md",
    "doc/architecture.md",
    "doc/development.md",
    "doc/decisions.md"
  ]
}
